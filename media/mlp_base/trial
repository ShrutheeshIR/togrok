@dataclass
class TrainerConfig:
    model: Literal["transformer", "mlp"] = "mlp"
    p: int = 97
    op: str = "/"
    train_fraction: float = 0.5
    batch_size: int = 2048
    seed: int = 42
    num_workers: int = 4
    dropout: float = 0.1

    num_layers: int = 2
    embed_dim: int = 256
    num_heads: int = 2
    context_size: int = 3

    lr: float = 1e-2
    weight_decay: float = 2e-3
    momentum: float = 0.9
    epochs: int = 100000
    beta1: float = 0.9
    beta2: float = 0.98
    log_dir: str = "experiments/logs"

    optimizer: Literal["sgd", "adam", "btls"] = "sgd"

    loss_type: LossType = "cross_entropy"
